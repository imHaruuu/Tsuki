@model IEnumerable<Category>
@{
    ViewData["Title"] = "Manage Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="section-title mb-1"><i class="bi bi-tags text-gold me-2"></i>Categories</h1>
        <p class="section-subtitle mb-0">Manage novel genre categories</p>
    </div>
    <a asp-action="Create" class="tsuki-btn-primary" id="btn-create-category">
        <i class="bi bi-plus-lg me-1"></i> Add Category
    </a>
</div>

<div class="admin-table">
    <table class="table mb-0">
        <thead>
            <tr>
                <th>Name</th>
                <th>Slug</th>
                <th>Novels</th>
                <th style="width:110px">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cat in Model)
            {
                <tr>
                    <td><span class="category-pill">@cat.Name</span></td>
                    <td style="color:var(--text-muted);font-size:0.8rem;">@cat.Slug</td>
                    <td>@cat.NovelCategories.Count</td>
                    <td>
                        <div class="d-flex gap-1">
                            <a asp-action="Edit" asp-route-id="@cat.Id" class="tsuki-btn-ghost btn-sm">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@cat.Id" method="post"
                                  onsubmit="return confirm('Delete this category?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="tsuki-btn-ghost btn-sm" style="color:#f06878;border-color:#f06878;">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

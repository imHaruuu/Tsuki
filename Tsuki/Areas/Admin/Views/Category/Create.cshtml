@model Tsuki.ViewModels.Admin.CreateCategoryViewModel
@{
    ViewData["Title"] = ViewBag.CategoryId != null ? "Edit Category" : "Add Category";
    bool isEdit       = ViewBag.CategoryId != null;
    string pageTitle  = isEdit ? "Edit Category" : "Add Category";
    string formAction = isEdit ? "Edit" : "Create";
    string btnLabel   = isEdit ? "Save Changes" : "Create Category";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="Index" class="tsuki-btn-ghost"><i class="bi bi-arrow-left me-1"></i> Back</a>
    <h1 class="section-title mb-0">@pageTitle</h1>
</div>

<div style="max-width:450px;">
    <form asp-action="@formAction" asp-route-id="@ViewBag.CategoryId" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Action" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Slug" class="form-label"></label>
                <input asp-for="Slug" class="form-control" placeholder="e.g. action" />
                <span asp-validation-for="Slug" class="text-danger"></span>
                <small style="color:var(--text-muted);font-size:0.8rem;">Lowercase letters, numbers, hyphens only.</small>
            </div>
            <div class="col-12">
                <button type="submit" class="tsuki-btn-primary">
                    <i class="bi bi-check-lg me-1"></i> @btnLabel
                </button>
            </div>
        </div>
    </form>
</div>

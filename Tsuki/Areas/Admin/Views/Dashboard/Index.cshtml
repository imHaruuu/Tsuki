@model IEnumerable<Tsuki.Models.ApplicationUser>
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1 class="section-title mb-1"><i class="bi bi-speedometer2 text-gold me-2"></i>Dashboard</h1>
<p class="section-subtitle mb-4">User management overview</p>

<div class="admin-table">
    <table class="table mb-0">
        <thead>
            <tr>
                <th>Display Name</th>
                <th>Email</th>
                <th>Username</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.DisplayName</td>
                    <td>@user.Email</td>
                    <td>@user.UserName</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@model IEnumerable<ApplicationUser>
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1 class="section-title mb-1"><i class="bi bi-speedometer2 text-gold me-2"></i>Dashboard</h1>
<p class="section-subtitle mb-4">User management overview</p>

<div class="admin-table">
    <table class="table mb-0">
        <thead>
            <tr>
                <th>Display Name</th>
                <th>Email</th>
                <th>Username</th>
                <th>Roles</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                string display = string.IsNullOrWhiteSpace(user.DisplayName)
                    ? user.Email ?? user.UserName ?? "—"
                    : user.DisplayName;
                <tr>
                    <td>@display</td>
                    <td>@user.Email</td>
                    <td>@user.UserName</td>
                    <td>
                        @if (ViewBag.UserRoles is Dictionary<string, List<string>> rolesMap
                             && rolesMap.TryGetValue(user.Id, out var roles) && roles.Count > 0)
                        {
                            foreach (var role in roles)
                            {
                                <span class="category-pill me-1">@role</span>
                            }
                        }
                        else
                        {
                            <span style="color:var(--text-muted);font-size:0.8rem;">User</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

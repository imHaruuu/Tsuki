@model Tsuki.ViewModels.Admin.CreateNovelViewModel
@{
    ViewData["Title"] = ViewBag.NovelId != null ? "Edit Novel" : "Add Novel";
    bool isEdit = ViewBag.NovelId != null;
    string formAction = isEdit ? "Edit" : "Create";
    string pageTitle  = isEdit ? "Edit Novel" : "Add Novel";
    string btnLabel   = isEdit ? "Save Changes" : "Create Novel";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="Index" class="tsuki-btn-ghost">
        <i class="bi bi-arrow-left me-1"></i> Back
    </a>
    <h1 class="section-title mb-0">@pageTitle</h1>
</div>

<div style="max-width:700px;">
    <form asp-action="@formAction" asp-route-id="@ViewBag.NovelId" method="post" id="novel-form">
        @Html.AntiForgeryToken()

        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" placeholder="Novel title" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="AuthorId" class="form-label"></label>
                <select asp-for="AuthorId" class="form-select"
                        asp-items="@(new SelectList(Model.AvailableAuthors, "Id", "Name"))">
                    <option value="">— Select Author —</option>
                </select>
                <span asp-validation-for="AuthorId" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select"
                        asp-items="Html.GetEnumSelectList<Tsuki.Models.NovelStatus>()">
                </select>
            </div>

            <div class="col-12">
                <label asp-for="CoverUrl" class="form-label"></label>
                <input asp-for="CoverUrl" class="form-control" placeholder="/images/covers/mynovel.jpg" />
            </div>

            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="5" placeholder="Novel synopsis..."></textarea>
            </div>

            <div class="col-12">
                <label class="form-label">Categories</label>
                <div class="d-flex flex-wrap gap-2 p-3" style="background:var(--bg-elevated);border:1px solid var(--border-color);border-radius:var(--radius-sm);">
                    @foreach (var cat in Model.AvailableCategories)
                    {
                        bool isChecked = Model.SelectedCategoryIds.Contains(cat.Id);
                        <div class="form-check">
                            @if (isChecked)
                            {
                                <input class="form-check-input" type="checkbox" name="SelectedCategoryIds"
                                       value="@cat.Id" id="cat-@cat.Id" checked
                                       style="background-color:var(--bg-elevated);border-color:var(--border-color);" />
                            }
                            else
                            {
                                <input class="form-check-input" type="checkbox" name="SelectedCategoryIds"
                                       value="@cat.Id" id="cat-@cat.Id"
                                       style="background-color:var(--bg-elevated);border-color:var(--border-color);" />
                            }
                            <label class="form-check-label" for="cat-@cat.Id"
                                   style="color:var(--text-secondary);font-size:0.875rem;">
                                @cat.Name
                            </label>
                        </div>
                    }
                </div>
            </div>

            <div class="col-12">
                <button type="submit" class="tsuki-btn-primary" id="btn-save-novel">
                    <i class="bi bi-check-lg me-1"></i> @btnLabel
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

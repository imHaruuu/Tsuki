@model Tsuki.ViewModels.Admin.CreateAuthorViewModel
@{
    ViewData["Title"] = ViewBag.AuthorId != null ? "Edit Author" : "Add Author";
    bool isEdit       = ViewBag.AuthorId != null;
    string pageTitle  = isEdit ? "Edit Author" : "Add Author";
    string formAction = isEdit ? "Edit" : "Create";
    string btnLabel   = isEdit ? "Save Changes" : "Create Author";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="Index" class="tsuki-btn-ghost"><i class="bi bi-arrow-left me-1"></i> Back</a>
    <h1 class="section-title mb-0">@pageTitle</h1>
</div>

<div style="max-width:500px;">
    <form asp-action="@formAction" asp-route-id="@ViewBag.AuthorId" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="Author's name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="AvatarUrl" class="form-label"></label>
                <input asp-for="AvatarUrl" class="form-control" placeholder="/images/avatars/author.jpg" />
            </div>
            <div class="col-12">
                <label asp-for="Bio" class="form-label"></label>
                <textarea asp-for="Bio" class="form-control" rows="4" placeholder="Short biography..."></textarea>
            </div>
            <div class="col-12">
                <button type="submit" class="tsuki-btn-primary">
                    <i class="bi bi-check-lg me-1"></i> @btnLabel
                </button>
            </div>
        </div>
    </form>
</div>

@{
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string dashboardClass = controllerName == "Dashboard" ? "admin-nav-link active" : "admin-nav-link";
    string novelClass     = controllerName == "Novel"     ? "admin-nav-link active" : "admin-nav-link";
    string authorClass    = controllerName == "Author"    ? "admin-nav-link active" : "admin-nav-link";
    string categoryClass  = controllerName == "Category"  ? "admin-nav-link active" : "admin-nav-link";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] &mdash; Tsuki Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Cinzel:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Top bar -->
    <nav class="tsuki-navbar navbar navbar-expand-lg">
        <div class="container-fluid">
            <a class="navbar-brand tsuki-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-moon">&#9790;</span>
                <span class="brand-text">Tsuki</span>
                <span class="ms-2" style="font-size:0.65rem;background:var(--accent-gold);color:#1a1a2e;padding:0.15rem 0.45rem;border-radius:4px;font-family:var(--font-body);font-weight:700;">ADMIN</span>
            </a>
            <div class="ms-auto d-flex align-items-center gap-2">
                <span style="font-size:0.8rem;color:var(--text-muted);">@User.Identity?.Name</span>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="tsuki-btn-ghost btn-sm">
                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                    </button>
                </form>
            </div>
        </div>
    </nav>

    <div class="d-flex" style="min-height:calc(100vh - 60px)">
        <!-- Sidebar -->
        <div class="admin-sidebar" style="width:220px;flex-shrink:0;">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="@dashboardClass">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
            <a asp-area="Admin" asp-controller="Novel" asp-action="Index" class="@novelClass">
                <i class="bi bi-book"></i> Novels
            </a>
            <a asp-area="Admin" asp-controller="Author" asp-action="Index" class="@authorClass">
                <i class="bi bi-person-badge"></i> Authors
            </a>
            <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="@categoryClass">
                <i class="bi bi-tags"></i> Categories
            </a>
            <hr style="border-color:var(--border-color);margin:0.75rem 1rem;" />
            <a asp-area="" asp-controller="Home" asp-action="Index" class="admin-nav-link">
                <i class="bi bi-house-door"></i> Back to Site
            </a>
        </div>

        <!-- Main content area -->
        <div class="flex-grow-1 p-4" style="background:var(--bg-base);">
            @if (TempData["Success"] != null)
            {
                <div class="tsuki-alert tsuki-alert-success mb-3">
                    <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="tsuki-alert tsuki-alert-error mb-3">
                    <i class="bi bi-x-circle me-2"></i>@TempData["Error"]
                </div>
            }
            @RenderBody()
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

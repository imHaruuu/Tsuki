@inject UserManager<ApplicationUser> UserManager
@{
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = currentUser?.DisplayName ?? User.Identity?.Name;

    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string dashboardClass = controllerName == "Dashboard" ? "admin-nav-link active" : "admin-nav-link";
    string novelClass     = controllerName == "Novel"     ? "admin-nav-link active" : "admin-nav-link";
    string authorClass    = controllerName == "Author"    ? "admin-nav-link active" : "admin-nav-link";
    string categoryClass  = controllerName == "Category"  ? "admin-nav-link active" : "admin-nav-link";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] &mdash; Tsuki Admin</title>
    <link rel="icon" type="image/x-icon" href="~/favico.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Gentle Theme Blur Load Overlay -->
    <div class="theme-blur-overlay"></div>

    <!-- Top bar -->
    <nav class="tsuki-navbar navbar navbar-expand-lg">
        <div class="container-fluid">
            <a class="navbar-brand tsuki-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <svg class="brand-logo-svg" viewBox="0 0 122.88 122.89" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="adminMoonGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#38bdf8" />
                            <stop offset="100%" stop-color="#bae6fd" />
                        </linearGradient>
                    </defs>
                    <path fill="url(#adminMoonGradient)" d="M49.06,1.27c2.17-0.45,4.34-0.77,6.48-0.98c2.2-0.21,4.38-0.31,6.53-0.29c1.21,0.01,2.18,1,2.17,2.21 c-0.01,0.93-0.6,1.72-1.42,2.03c-9.15,3.6-16.47,10.31-20.96,18.62c-4.42,8.17-6.1,17.88-4.09,27.68l0.01,0.07 c2.29,11.06,8.83,20.15,17.58,25.91c8.74,5.76,19.67,8.18,30.73,5.92l0.07-0.01c7.96-1.65,14.89-5.49,20.3-10.78 c5.6-5.47,9.56-12.48,11.33-20.16c0.27-1.18,1.45-1.91,2.62-1.64c0.89,0.21,1.53,0.93,1.67,1.78c2.64,16.2-1.35,32.07-10.06,44.71 c-8.67,12.58-22.03,21.97-38.18,25.29c-16.62,3.42-33.05-0.22-46.18-8.86C14.52,104.1,4.69,90.45,1.27,73.83 C-2.07,57.6,1.32,41.55,9.53,28.58C17.78,15.57,30.88,5.64,46.91,1.75c0.31-0.08,0.67-0.16,1.06-0.25l0.01,0l0,0L49.06,1.27 L49.06,1.27z"/>
                </svg>
                <span class="brand-text">Tsuki</span>
                <span class="ms-2" style="font-size:0.65rem;background:var(--accent-gold);color:#1a1a2e;padding:0.15rem 0.45rem;border-radius:4px;font-family:var(--font-body);font-weight:700;">ADMIN</span>
            </a>
            <div class="ms-auto d-flex align-items-center gap-2">
                <span style="font-size:0.8rem;color:var(--text-muted);">@displayName</span>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="tsuki-btn-ghost btn-sm">
                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                    </button>
                </form>
            </div>
        </div>
    </nav>

    <div class="d-flex" style="min-height:calc(100vh - 60px)">
        <!-- Sidebar -->
        <div class="admin-sidebar" style="width:220px;flex-shrink:0;">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="@dashboardClass">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
            <a asp-area="Admin" asp-controller="Novel" asp-action="Index" class="@novelClass">
                <i class="bi bi-book"></i> Novels
            </a>
            <a asp-area="Admin" asp-controller="Author" asp-action="Index" class="@authorClass">
                <i class="bi bi-person-badge"></i> Authors
            </a>
            <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="@categoryClass">
                <i class="bi bi-tags"></i> Categories
            </a>
            <hr style="border-color:var(--border-color);margin:0.75rem 1rem;" />
            <a asp-area="" asp-controller="Home" asp-action="Index" class="admin-nav-link">
                <i class="bi bi-house-door"></i> Back to Site
            </a>
        </div>

        <!-- Main content area -->
        <div class="flex-grow-1 p-4" style="background:var(--bg-base);">
            @if (TempData["Success"] != null)
            {
                <div class="tsuki-alert tsuki-alert-success mb-3">
                    <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="tsuki-alert tsuki-alert-error mb-3">
                    <i class="bi bi-x-circle me-2"></i>@TempData["Error"]
                </div>
            }
            @RenderBody()
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

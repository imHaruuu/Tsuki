@model Tsuki.ViewModels.Admin.CreateChapterViewModel
@{
    ViewData["Title"] = ViewBag.ChapterId != null ? "Edit Chapter" : "Add Chapter";
    bool isEdit        = ViewBag.ChapterId != null;
    string pageTitle   = isEdit ? "Edit Chapter" : "Add Chapter";
    string formAction  = isEdit ? "Edit" : "Create";
    string btnLabel    = isEdit ? "Save Changes" : "Create Chapter";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="Index" class="tsuki-btn-ghost"><i class="bi bi-arrow-left me-1"></i> Back</a>
    <h1 class="section-title mb-0">@pageTitle</h1>
</div>

<div style="max-width:800px;">
    <form asp-action="@formAction" asp-route-id="@ViewBag.ChapterId" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="NovelId" class="form-label"></label>
                <select asp-for="NovelId" class="form-select"
                        asp-items="@(new SelectList(Model.AvailableNovels, "Id", "Title"))">
                    <option value="">— Select Novel —</option>
                </select>
                <span asp-validation-for="NovelId" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ChapterNumber" class="form-label"></label>
                <input asp-for="ChapterNumber" class="form-control" type="number" min="1" />
                <span asp-validation-for="ChapterNumber" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" placeholder="Chapter title" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Content" class="form-label">
                    Content <small style="color:var(--text-muted);">(HTML supported)</small>
                </label>
                <textarea asp-for="Content" class="form-control" rows="18"
                          placeholder="Chapter content... You can use &lt;p&gt; tags."></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>
            <div class="col-12">
                <button type="submit" class="tsuki-btn-primary" id="btn-save-chapter">
                    <i class="bi bi-check-lg me-1"></i> @btnLabel
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

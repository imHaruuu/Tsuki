@model Tsuki.ViewModels.NovelListViewModel
@{
    string searchAction = Url.Action("Search", "Novel") ?? "/Novel/Search";
}

@if (Model.Novels.Any())
{
    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-4 g-3">
        @foreach (var novel in Model.Novels)
        {
            <div class="col">
                @await Html.PartialAsync("~/Views/Shared/_NovelCard.cshtml", novel)
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="tsuki-pagination" id="pagination-wrap">
            @if (Model.HasPrevPage)
            {
                string prevUrl = Url.Action("Search", "Novel", new { q = Model.SearchQuery, category = Model.ActiveCategoryId, page = Model.CurrentPage - 1 }) ?? searchAction;
                <a class="tsuki-page-btn"
                   hx-get="@prevUrl"
                   hx-target="#novel-list"
                   hx-push-url="false"
                   href="#">
                    <i class="bi bi-chevron-left"></i>
                </a>
            }

            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                string cls = p == Model.CurrentPage ? "tsuki-page-btn active" : "tsuki-page-btn";
                string pUrl = Url.Action("Search", "Novel", new { q = Model.SearchQuery, category = Model.ActiveCategoryId, page = p }) ?? searchAction;
                <a class="@cls"
                   hx-get="@pUrl"
                   hx-target="#novel-list"
                   hx-push-url="false"
                   href="#">
                    @p
                </a>
            }

            @if (Model.HasNextPage)
            {
                string nextUrl = Url.Action("Search", "Novel", new { q = Model.SearchQuery, category = Model.ActiveCategoryId, page = Model.CurrentPage + 1 }) ?? searchAction;
                <a class="tsuki-page-btn"
                   hx-get="@nextUrl"
                   hx-target="#novel-list"
                   hx-push-url="false"
                   href="#">
                    <i class="bi bi-chevron-right"></i>
                </a>
            }
        </div>
    }
}
else
{
    <div class="text-center py-5">
        <div style="font-size:3.5rem;opacity:0.4">&#128214;</div>
        <h4 class="mt-3" style="color:var(--text-secondary)">No novels found</h4>
        <p style="color:var(--text-muted)">Try a different search term or category.</p>
    </div>
}

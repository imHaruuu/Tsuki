@model Tsuki.ViewModels.NovelCardViewModel
@{
    string statusClass = Model.Status switch {
        Tsuki.Models.NovelStatus.Ongoing   => "status-ongoing",
        Tsuki.Models.NovelStatus.Completed => "status-completed",
        Tsuki.Models.NovelStatus.Hiatus    => "status-hiatus",
        _                                  => "status-ongoing"
    };
    string statusText = Model.Status.ToString();
}

<a asp-controller="Novel" asp-action="Detail" asp-route-id="@Model.Id" class="text-decoration-none d-block h-100">
    <div class="novel-card h-100">
        <div class="novel-cover-wrap">
            @if (!string.IsNullOrEmpty(Model.CoverUrl))
            {
                <img src="@Model.CoverUrl" alt="@Model.Title cover" class="novel-cover" loading="lazy" />
            }
            else
            {
                <div class="novel-cover-placeholder">&#128218;</div>
            }
            <span class="novel-status-badge @statusClass">@statusText</span>
        </div>
        <div class="novel-card-body">
            <h3 class="novel-card-title">@Model.Title</h3>
            <p class="novel-card-author">
                <i class="bi bi-person me-1"></i>@Model.AuthorName
            </p>
            @if (Model.CategoryNames.Any())
            {
                <div class="d-flex flex-wrap gap-1 mt-1">
                    @foreach (var cat in Model.CategoryNames.Take(2))
                    {
                        <span class="category-pill">@cat</span>
                    }
                </div>
            }
            <div class="novel-card-meta">
                <span><i class="bi bi-journals me-1"></i>@Model.ChapterCount ch.</span>
                <span><i class="bi bi-eye me-1"></i>@Model.ViewCount.ToString("N0")</span>
            </div>
        </div>
    </div>
</a>

@model ChapterReadViewModel
@{
    ViewData["Title"] = $"Ch.{Model.ChapterNumber} — {Model.NovelTitle}";
    string prevUrl = Model.PrevChapterId.HasValue
        ? Url.Action("Read", "Chapter", new { id = Model.PrevChapterId }) ?? "#"
        : "#";
    string nextUrl = Model.NextChapterId.HasValue
        ? Url.Action("Read", "Chapter", new { id = Model.NextChapterId }) ?? "#"
        : "#";
    string novelUrl = Url.Action("Detail", "Novel", new { id = Model.NovelId }) ?? "#";
}

<div class="reader-page">
<!-- Reading Progress Bar -->
<div class="reader-progress-bar" id="reader-progress-bar"></div>
<div class="reader-wrap" id="reader-wrap">
    <!-- Breadcrumb -->
    <nav class="reader-breadcrumb" aria-label="breadcrumb">
        <a asp-controller="Home" asp-action="Index">Home</a>
        <span class="mx-2">›</span>
        <a asp-controller="Novel" asp-action="Index">Novels</a>
        <span class="mx-2">›</span>
        <a asp-controller="Novel" asp-action="Detail" asp-route-id="@Model.NovelId">@Model.NovelTitle</a>
        <span class="mx-2">›</span>
        <span style="color:var(--text-primary)">Chapter @Model.ChapterNumber</span>
    </nav>

    <!-- Chapter navigation (top) -->
    <div class="reader-nav mb-4" id="nav-top">
        @if (Model.PrevChapterId.HasValue)
        {
            <a href="@prevUrl"
               hx-get="@prevUrl"
               hx-target="#reader-wrap"
               hx-swap="outerHTML"
               hx-push-url="true"
               hx-indicator="#reader-indicator"
               class="reader-nav-btn prev" id="btn-prev-chapter">
                <i class="bi bi-chevron-left"></i> Ch.@Model.PrevChapterNumber
            </a>
        }
        else
        {
            <span></span>
        }

        <div class="d-flex gap-2 align-items-center">
            <a href="@novelUrl" class="tsuki-btn-ghost" id="btn-back-to-novel">
                <i class="bi bi-list-ul me-1"></i>Chapter List
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                ViewBag.NovelId = Model.NovelId;
                ViewBag.ChapterId = Model.Id;
                ViewBag.IsBookmarked = Model.IsBookmarked;
                <partial name="~/Views/Shared/_BookmarkButton.cshtml" />
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="tsuki-btn-ghost" id="btn-login-to-bookmark" title="Login to Bookmark">
                    <i class="bi bi-bookmark"></i>
                </a>
            }
        </div>

        @if (Model.NextChapterId.HasValue)
        {
            <a href="@nextUrl"
               hx-get="@nextUrl"
               hx-target="#reader-wrap"
               hx-swap="outerHTML"
               hx-push-url="true"
               hx-indicator="#reader-indicator"
               class="reader-nav-btn next" id="btn-next-chapter">
                Ch.@Model.NextChapterNumber <i class="bi bi-chevron-right"></i>
            </a>
        }
        else
        {
            <span></span>
        }
    </div>

    <!-- Loading indicator -->
    <div id="reader-indicator" class="htmx-indicator text-center py-3">
        <div class="spinner"></div>
    </div>

    <!-- Chapter title -->
    <h1 class="reader-chapter-title">@Model.Title</h1>
    <p class="reader-meta">
        <i class="bi bi-book me-1"></i> @Model.NovelTitle
        &nbsp;·&nbsp;
        <i class="bi bi-text-paragraph me-1"></i> @Model.WordCount.ToString("N0") words
    </p>

    <!-- Chapter content -->
    <article class="reader-content" id="chapter-content">
        @Html.Raw(Model.Content)
    </article>

    <!-- Chapter navigation (bottom) -->
    <div class="reader-nav mt-5" id="nav-bottom">
        @if (Model.PrevChapterId.HasValue)
        {
            <a href="@prevUrl"
               hx-get="@prevUrl"
               hx-target="#reader-wrap"
               hx-swap="outerHTML"
               hx-push-url="true"
               hx-indicator="#reader-indicator"
               class="reader-nav-btn prev">
                <i class="bi bi-chevron-left"></i> Chapter @Model.PrevChapterNumber
            </a>
        }
        else
        {
            <span></span>
        }

        @if (Model.NextChapterId.HasValue)
        {
            <a href="@nextUrl"
               hx-get="@nextUrl"
               hx-target="#reader-wrap"
               hx-swap="outerHTML"
               hx-push-url="true"
               hx-indicator="#reader-indicator"
               class="reader-nav-btn next">
                Chapter @Model.NextChapterNumber <i class="bi bi-chevron-right"></i>
            </a>
        }
        else
        {
            <div class="text-center" style="color:var(--text-muted);font-size:0.875rem;">
                <i class="bi bi-check-circle me-1 text-gold"></i>
                You've reached the last available chapter!
                <a asp-controller="Novel" asp-action="Detail" asp-route-id="@Model.NovelId" class="d-block mt-2 tsuki-btn-outline">
                    Back to Novel
                </a>
            </div>
        }
    </div>
</div><!-- /reader-wrap -->
</div><!-- /reader-page -->

@section ReaderSettings {
<!-- Settings Backdrop -->
<div class="reader-settings-backdrop" id="reader-settings-backdrop"></div>

<!-- Reader settings FAB + panel -- outside reader-page to ensure position:fixed works correctly -->
<button class="reader-settings-toggle" id="reader-settings-toggle-btn" type="button" title="Reader Settings" aria-label="Reader Settings">
    <span class="fab-icon"><i class="bi bi-gear-fill"></i></span>
</button>

<div class="reader-settings-panel" id="reader-settings-panel">
    <div class="settings-section-title">
        <span>Reader Settings</span>
        <button class="settings-close-btn" id="settings-close-btn" type="button" title="Close" aria-label="Close">&times;</button>
    </div>
    <div class="reader-settings-inner">
    <!-- Theme options -->
    <div class="settings-section">
        <label>Theme</label>
        <div class="theme-options">
            <button class="theme-opt theme-opt-light" data-theme="light" type="button" title="Light Theme"></button>
            <button class="theme-opt theme-opt-sepia" data-theme="sepia" type="button" title="Sepia Theme"></button>
            <button class="theme-opt theme-opt-twilight" data-theme="twilight" type="button" title="Twilight Theme"></button>
            <button class="theme-opt theme-opt-void" data-theme="void" type="button" title="Deep Void"></button>
        </div>
    </div>
    
    <!-- Font Selection -->
    <div class="settings-section">
        <label>Font Style</label>
        <div class="btn-group btn-group-sm">
            <button class="btn tsuki-btn-ghost" data-font="sans" type="button">Sans</button>
            <button class="btn tsuki-btn-ghost" data-font="serif" type="button">Serif</button>
            <button class="btn tsuki-btn-ghost" data-font="mono" type="button">Mono</button>
        </div>
    </div>
    
    <!-- Font Size -->
    <div class="settings-section">
        <label>Font Size</label>
        <div class="d-flex align-items-center justify-content-between gap-2">
            <button class="btn tsuki-btn-ghost btn-sm flex-grow-1" id="font-size-dec" type="button"><i class="bi bi-dash"></i></button>
            <span id="font-size-val" style="font-weight: 600; min-width: 3.5rem; text-align: center; color: var(--accent-gold);">100%</span>
            <button class="btn tsuki-btn-ghost btn-sm flex-grow-1" id="font-size-inc" type="button"><i class="bi bi-plus"></i></button>
        </div>
    </div>
    
    <!-- Auto scroll -->
    <div class="settings-section">
        <label class="d-flex align-items-center justify-content-between">
            <span>Auto Scroll</span>
            <button class="tsuki-btn-primary btn-sm px-2 py-1" id="auto-scroll-toggle-btn" type="button" style="font-size:0.75rem;">
                <i class="bi bi-play-fill"></i> Start
            </button>
        </label>
        <div class="d-flex align-items-center justify-content-between gap-2 mt-1" id="scroll-speed-section" style="display: none !important;">
            <button class="btn tsuki-btn-ghost btn-sm flex-grow-1" id="scroll-speed-dec" type="button"><i class="bi bi-dash"></i></button>
            <span id="scroll-speed-val" style="font-weight: 600; min-width: 3.5rem; text-align: center; font-size:0.8rem; color: var(--accent-blue);">Speed 2</span>
            <button class="btn tsuki-btn-ghost btn-sm flex-grow-1" id="scroll-speed-inc" type="button"><i class="bi bi-plus"></i></button>
        </div>
    </div>

    <!-- Text-to-Speech -->
    <div class="settings-section">
        <label class="d-flex align-items-center justify-content-between">
            <span>Text to Speech</span>
            <button class="tsuki-btn-primary btn-sm px-2 py-1" id="tts-toggle-btn" type="button" style="font-size:0.75rem;">
                <i class="bi bi-play-fill"></i> Read
            </button>
        </label>

        <!-- Speed -->
        <div class="d-flex align-items-center justify-content-between gap-2 mt-2">
            <span style="font-size:0.75rem;color:var(--text-muted);white-space:nowrap;">Speed</span>
            <button class="btn tsuki-btn-ghost btn-sm" id="tts-speed-dec" type="button"><i class="bi bi-dash"></i></button>
            <span id="tts-speed-val" style="font-weight:600;min-width:2.5rem;text-align:center;font-size:0.8rem;color:var(--accent-gold);">1.0x</span>
            <button class="btn tsuki-btn-ghost btn-sm" id="tts-speed-inc" type="button"><i class="bi bi-plus"></i></button>
        </div>

        <!-- Voice -->
        <div class="mt-2">
            <select id="tts-voice-select" class="form-select form-select-sm" style="background:var(--surface-card);color:var(--text-primary);border-color:var(--border-subtle);font-size:0.75rem;"></select>
        </div>

        <!-- Volume -->
        <div class="d-flex align-items-center gap-2 mt-2">
            <i class="bi bi-volume-down" style="font-size:0.85rem;color:var(--text-muted);flex-shrink:0;"></i>
            <input type="range" id="tts-volume-slider" min="0" max="1" step="0.05" value="1"
                   style="flex:1;accent-color:var(--accent-gold);cursor:pointer;height:4px;">
            <i class="bi bi-volume-up" style="font-size:0.85rem;color:var(--text-muted);flex-shrink:0;"></i>
        </div>
    </div>
    </div><!-- /reader-settings-inner -->
</div>

<script>
        (function() {
            // 1. Get DOM elements
            const readerWrap = document.getElementById('reader-wrap');
            const readerContent = document.getElementById('chapter-content');
            const settingsPanel = document.getElementById('reader-settings-panel');
            const toggleBtn = document.getElementById('reader-settings-toggle-btn');
            const closeBtn = document.getElementById('settings-close-btn');
            const backdrop = document.getElementById('reader-settings-backdrop');
            const progressBar = document.getElementById('reader-progress-bar');
            const fontSizeVal = document.getElementById('font-size-val');
            const fontSizeDec = document.getElementById('font-size-dec');
            const fontSizeInc = document.getElementById('font-size-inc');
            const scrollToggleBtn = document.getElementById('auto-scroll-toggle-btn');
            const scrollSpeedSection = document.getElementById('scroll-speed-section');
            const scrollSpeedVal = document.getElementById('scroll-speed-val');
            const scrollSpeedDec = document.getElementById('scroll-speed-dec');
            const scrollSpeedInc = document.getElementById('scroll-speed-inc');

            if (!readerWrap || !readerContent || !settingsPanel) return;

            // Open / Close panel helpers
            function openPanel() {
                settingsPanel.classList.add('open');
                if (backdrop) backdrop.classList.add('open');
                if (toggleBtn) toggleBtn.classList.add('open');
            }
            function closePanel() {
                settingsPanel.classList.remove('open');
                if (backdrop) backdrop.classList.remove('open');
                if (toggleBtn) toggleBtn.classList.remove('open');
            }

            // Reading progress bar
            if (progressBar) {
                window.addEventListener('scroll', () => {
                    const scrollTop = window.scrollY;
                    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
                    const pct = docHeight > 0 ? Math.min(100, (scrollTop / docHeight) * 100) : 0;
                    progressBar.style.width = pct + '%';
                }, { passive: true });
            }

            // Helper functions — declared first
            function applyTheme(theme) {
                const wrap = document.getElementById('reader-wrap');
                if (wrap) {
                    wrap.classList.remove('theme-light', 'theme-sepia', 'theme-twilight', 'theme-void');
                    wrap.classList.add('theme-' + theme);
                }
                if (settingsPanel) {
                    settingsPanel.querySelectorAll('.theme-opt').forEach(opt => {
                        opt.classList.toggle('active', opt.getAttribute('data-theme') === theme);
                    });
                }
            }

            function applyFont(font) {
                const content = document.getElementById('chapter-content');
                if (content) {
                    content.classList.remove('font-sans', 'font-serif', 'font-mono');
                    content.classList.add('font-' + font);
                }
                if (settingsPanel) {
                    settingsPanel.querySelectorAll('[data-font]').forEach(opt => {
                        opt.classList.toggle('active', opt.getAttribute('data-font') === font);
                    });
                }
            }

            // Apply size
            function applyFontSize(size) {
                const content = document.getElementById('chapter-content');
                if (content) {
                    content.style.fontSize = size + '%';
                }
                if (fontSizeVal) fontSizeVal.textContent = size + '%';
            }

            // 2. Load and Apply settings from localStorage
            const savedTheme = localStorage.getItem('reader-theme') || 'twilight';
            const savedFont = localStorage.getItem('reader-font') || 'sans';
            const savedFontSize = parseInt(localStorage.getItem('reader-font-size') || '100');

            applyTheme(savedTheme);
            applyFont(savedFont);
            applyFontSize(savedFontSize);

            // 3. Theme Toggle Handlers
            settingsPanel.querySelectorAll('.theme-opt').forEach(opt => {
                opt.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const theme = this.getAttribute('data-theme');
                    applyTheme(theme);
                    localStorage.setItem('reader-theme', theme);
                });
            });

            // 4. Font Toggle Handlers
            settingsPanel.querySelectorAll('[data-font]').forEach(opt => {
                opt.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const font = this.getAttribute('data-font');
                    applyFont(font);
                    localStorage.setItem('reader-font', font);
                });
            });

            // 5. Font Size Handlers
            let currentFontSize = savedFontSize;
            if (fontSizeDec) {
                fontSizeDec.addEventListener('click', (e) => {
                    e.stopPropagation();
                    if (currentFontSize > 70) {
                        currentFontSize -= 10;
                        applyFontSize(currentFontSize);
                        localStorage.setItem('reader-font-size', currentFontSize);
                    }
                });
            }
            if (fontSizeInc) {
                fontSizeInc.addEventListener('click', (e) => {
                    e.stopPropagation();
                    if (currentFontSize < 180) {
                        currentFontSize += 10;
                        applyFontSize(currentFontSize);
                        localStorage.setItem('reader-font-size', currentFontSize);
                    }
                });
            }

            // 6. Toggle Settings Panel Visibility
            if (toggleBtn) {
                toggleBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    if (settingsPanel.classList.contains('open')) {
                        closePanel();
                    } else {
                        openPanel();
                    }
                });
            }
            if (closeBtn) {
                closeBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    closePanel();
                });
            }
            if (backdrop) {
                backdrop.addEventListener('click', () => closePanel());
            }

            // 7. Auto Scroll Logic
            let isScrolling = false;
            let scrollInterval = null;
            let scrollSpeed = parseInt(localStorage.getItem('reader-scroll-speed') || '2');
            const scrollIntervalMs = 50;

            if (scrollSpeedVal) scrollSpeedVal.textContent = 'Speed ' + scrollSpeed;

            if (scrollToggleBtn) {
                scrollToggleBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    if (isScrolling) {
                        stopAutoScroll();
                    } else {
                        startAutoScroll();
                    }
                });
            }

            if (scrollSpeedDec) {
                scrollSpeedDec.addEventListener('click', (e) => {
                    e.stopPropagation();
                    if (scrollSpeed > 1) {
                        scrollSpeed -= 1;
                        if (scrollSpeedVal) scrollSpeedVal.textContent = 'Speed ' + scrollSpeed;
                        localStorage.setItem('reader-scroll-speed', scrollSpeed);
                        if (isScrolling) startAutoScroll();
                    }
                });
            }

            if (scrollSpeedInc) {
                scrollSpeedInc.addEventListener('click', (e) => {
                    e.stopPropagation();
                    if (scrollSpeed < 10) {
                        scrollSpeed += 1;
                        if (scrollSpeedVal) scrollSpeedVal.textContent = 'Speed ' + scrollSpeed;
                        localStorage.setItem('reader-scroll-speed', scrollSpeed);
                        if (isScrolling) startAutoScroll();
                    }
                });
            }

            function startAutoScroll() {
                isScrolling = true;
                if (scrollToggleBtn) scrollToggleBtn.innerHTML = '<i class="bi bi-pause-fill"></i> Pause';
                if (scrollSpeedSection) scrollSpeedSection.style.setProperty('display', 'flex', 'important');
                if (scrollInterval) clearInterval(scrollInterval);
                scrollInterval = setInterval(() => {
                    window.scrollBy({ top: scrollSpeed, behavior: 'auto' });
                    if ((window.innerHeight + window.scrollY) >= document.documentElement.scrollHeight - 2) {
                        stopAutoScroll();
                    }
                }, scrollIntervalMs);
            }

            function stopAutoScroll() {
                isScrolling = false;
                if (scrollToggleBtn) scrollToggleBtn.innerHTML = '<i class="bi bi-play-fill"></i> Start';
                if (scrollSpeedSection) scrollSpeedSection.style.removeProperty('display');
                if (scrollInterval) {
                    clearInterval(scrollInterval);
                    scrollInterval = null;
                }
            }

            // Clean up on HTMX swap
            document.addEventListener('htmx:beforeSwap', () => {
                stopAutoScroll();
                ttsStop();
            });

            // Re-apply settings on HTMX swap
            document.body.addEventListener('htmx:afterSwap', (evt) => {
                if (evt.detail.target && evt.detail.target.id === 'reader-wrap') {
                    const currentTheme = localStorage.getItem('reader-theme') || 'twilight';
                    const currentFont = localStorage.getItem('reader-font') || 'sans';
                    const currentFontSize = parseInt(localStorage.getItem('reader-font-size') || '100');

                    applyTheme(currentTheme);
                    applyFont(currentFont);
                    applyFontSize(currentFontSize);

                    if (progressBar) {
                        progressBar.style.width = '0%';
                    }
                }
            });

            // ── Text-to-Speech ────────────────────────────────────────
            const ttsToggleBtn    = document.getElementById('tts-toggle-btn');
            const ttsSpeedDec     = document.getElementById('tts-speed-dec');
            const ttsSpeedInc     = document.getElementById('tts-speed-inc');
            const ttsSpeedVal     = document.getElementById('tts-speed-val');
            const ttsVoiceSelect  = document.getElementById('tts-voice-select');
            const ttsVolumeSlider = document.getElementById('tts-volume-slider');

            const TTS_SPEEDS = [0.5, 0.75, 1.0, 1.25, 1.5, 1.75, 2.0];
            let ttsSpeedIdx  = parseInt(localStorage.getItem('tts-speed-idx') || '2');
            let ttsVolume    = parseFloat(localStorage.getItem('tts-volume') || '1');
            let ttsVoices    = [];
            let ttsActive    = false;
            let ttsCharIndex = 0;   // tracks current read position via boundary event
            let ttsFullText  = '';  // full chapter text cached at ttsStart()

            function ttsGetText() {
                const article = document.getElementById('chapter-content');
                return article ? (article.innerText || article.textContent || '') : '';
            }

            function ttsUpdateSpeedUI() {
                if (ttsSpeedVal) ttsSpeedVal.textContent = TTS_SPEEDS[ttsSpeedIdx].toFixed(2).replace(/\.?0+$/, '') + 'x';
            }

            function ttsPopulateVoices() {
                ttsVoices = window.speechSynthesis.getVoices();
                if (!ttsVoiceSelect) return;
                const savedUri = localStorage.getItem('tts-voice-uri') || '';
                ttsVoiceSelect.innerHTML = '';

                // Prefer Vietnamese voices first
                const viVoices  = ttsVoices.filter(v => v.lang.startsWith('vi'));
                const enVoices  = ttsVoices.filter(v => v.lang.startsWith('en'));
                const othVoices = ttsVoices.filter(v => !v.lang.startsWith('vi') && !v.lang.startsWith('en'));
                const ordered   = [...viVoices, ...enVoices, ...othVoices];

                ordered.forEach(v => {
                    const opt = document.createElement('option');
                    opt.value = v.voiceURI;
                    opt.textContent = `${v.name} (${v.lang})`;
                    if (v.voiceURI === savedUri) opt.selected = true;
                    ttsVoiceSelect.appendChild(opt);
                });

                // Default to first Vietnamese voice if nothing saved
                if (!savedUri && viVoices.length > 0) {
                    ttsVoiceSelect.value = viVoices[0].voiceURI;
                }
            }

            function ttsGetSelectedVoice() {
                if (!ttsVoiceSelect) return null;
                const uri = ttsVoiceSelect.value;
                return ttsVoices.find(v => v.voiceURI === uri) || null;
            }

            // ttsStartFrom: speak from a given char offset in ttsFullText
            function ttsStartFrom(charOffset) {
                window.speechSynthesis.cancel();

                const remaining = ttsFullText.substring(charOffset).trim();
                if (!remaining) return;

                const utter = new SpeechSynthesisUtterance(remaining);
                utter.rate   = TTS_SPEEDS[ttsSpeedIdx];
                utter.volume = ttsVolume;
                utter.pitch  = 1;

                const voice = ttsGetSelectedVoice();
                if (voice) utter.voice = voice;

                // Track position: boundary charIndex is relative to this utterance's text,
                // so we add charOffset to keep it absolute within ttsFullText.
                utter.addEventListener('boundary', (e) => {
                    if (e.charIndex !== undefined) {
                        ttsCharIndex = charOffset + e.charIndex;
                    }
                });

                utter.onstart = () => {
                    ttsActive = true;
                    if (ttsToggleBtn) ttsToggleBtn.innerHTML = '<i class="bi bi-stop-fill"></i> Stop';
                };
                utter.onend = utter.onerror = () => {
                    ttsActive = false;
                    ttsCharIndex = 0;
                    if (ttsToggleBtn) ttsToggleBtn.innerHTML = '<i class="bi bi-play-fill"></i> Read';
                };

                window.speechSynthesis.speak(utter);
            }

            function ttsStart() {
                if (!('speechSynthesis' in window)) {
                    alert('Trình duyệt của bạn không hỗ trợ Text-to-Speech.');
                    return;
                }
                ttsFullText  = ttsGetText().trim();
                ttsCharIndex = 0;
                ttsStartFrom(0);
            }

            function ttsStop() {
                window.speechSynthesis && window.speechSynthesis.cancel();
                ttsActive    = false;
                ttsCharIndex = 0;
                if (ttsToggleBtn) ttsToggleBtn.innerHTML = '<i class="bi bi-play-fill"></i> Read';
            }

            // Init voices (Chrome fires voiceschanged asynchronously)
            if ('speechSynthesis' in window) {
                ttsPopulateVoices();
                window.speechSynthesis.addEventListener('voiceschanged', ttsPopulateVoices);
            }

            // Restore volume slider
            if (ttsVolumeSlider) ttsVolumeSlider.value = ttsVolume;
            ttsUpdateSpeedUI();

            if (ttsToggleBtn) {
                ttsToggleBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    if (ttsActive) { ttsStop(); } else { ttsStart(); }
                });
            }

            if (ttsSpeedDec) {
                ttsSpeedDec.addEventListener('click', (e) => {
                    e.stopPropagation();
                    if (ttsSpeedIdx > 0) {
                        ttsSpeedIdx--;
                        ttsUpdateSpeedUI();
                        localStorage.setItem('tts-speed-idx', ttsSpeedIdx);
                        // Resume from current position with new speed
                        if (ttsActive) {
                            const resumeAt = ttsCharIndex;
                            window.speechSynthesis.cancel();
                            ttsStartFrom(resumeAt);
                        }
                    }
                });
            }

            if (ttsSpeedInc) {
                ttsSpeedInc.addEventListener('click', (e) => {
                    e.stopPropagation();
                    if (ttsSpeedIdx < TTS_SPEEDS.length - 1) {
                        ttsSpeedIdx++;
                        ttsUpdateSpeedUI();
                        localStorage.setItem('tts-speed-idx', ttsSpeedIdx);
                        // Resume from current position with new speed
                        if (ttsActive) {
                            const resumeAt = ttsCharIndex;
                            window.speechSynthesis.cancel();
                            ttsStartFrom(resumeAt);
                        }
                    }
                });
            }

            if (ttsVoiceSelect) {
                ttsVoiceSelect.addEventListener('change', (e) => {
                    e.stopPropagation();
                    localStorage.setItem('tts-voice-uri', ttsVoiceSelect.value);
                    // Resume from current position with new voice
                    if (ttsActive) {
                        const resumeAt = ttsCharIndex;
                        window.speechSynthesis.cancel();
                        ttsStartFrom(resumeAt);
                    }
                });
            }

            if (ttsVolumeSlider) {
                ttsVolumeSlider.addEventListener('input', (e) => {
                    e.stopPropagation();
                    ttsVolume = parseFloat(ttsVolumeSlider.value);
                    localStorage.setItem('tts-volume', ttsVolume);
                    // Volume cannot be changed on a live utterance in Web Speech API,
                    // so we resume from the tracked char position — no full restart.
                    if (ttsActive) {
                        const resumeAt = ttsCharIndex;
                        window.speechSynthesis.cancel();
                        ttsStartFrom(resumeAt);
                    }
                });
            }
            // ── End TTS ───────────────────────────────────────────────
        })();
    </script>
}

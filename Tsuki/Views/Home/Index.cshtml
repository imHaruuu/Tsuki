@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Home";
    var featured = ViewBag.FeaturedNovels as List<NovelCardViewModel> ?? new List<NovelCardViewModel>();
    var recent   = ViewBag.RecentNovels   as List<NovelCardViewModel> ?? new List<NovelCardViewModel>();

    // Lấy DisplayName thật của user, không dùng email
    ApplicationUser? currentUser = null;
    if (User.Identity?.IsAuthenticated == true)
        currentUser = await UserManager.GetUserAsync(User);
    var displayName = currentUser?.DisplayName?.Trim();
    if (string.IsNullOrEmpty(displayName))
        displayName = User.Identity?.IsAuthenticated == true ? (User.Identity.Name ?? "bạn") : "bạn";
}

<!-- ── Hero Section ────────────────────────────────────────────── -->
<section class="tsuki-hero">
    <div class="container position-relative" style="z-index:1">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <!-- Greeting -->
                <p class="hero-greeting" id="hero-greeting">
                    <i class="bi bi-moon-stars-fill me-2"></i>Xin chào, <span class="hero-username">@displayName</span>
                </p>

                <!-- Random moonlight quote (populated via JS) -->
                <blockquote class="hero-quote" id="hero-quote">
                    <span class="hero-quote-text" id="hero-quote-text"></span>
                    <cite class="hero-quote-author" id="hero-quote-author"></cite>
                </blockquote>

                <h1 class="hero-title">Endless Stories,<br />One Click Away</h1>
                <p class="hero-subtitle">
                    Dive into thousands of light novels, web novels, and fantasy epics.
                    Read anywhere, bookmark your favorites, and never lose your place.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    <a asp-controller="Novel" asp-action="Index" class="tsuki-btn-primary" id="btn-browse-novels">
                        <i class="bi bi-book-half"></i> Browse Novels
                    </a>
                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <a asp-controller="Account" asp-action="Register" class="tsuki-btn-outline" id="btn-get-started">
                            Get Started Free
                        </a>
                    }
                </div>
                <div class="hero-stats">
                    <div class="stat-item">
                        <span class="stat-number">@featured.Count+</span>
                        <span class="stat-label">Novels</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number">Free</span>
                        <span class="stat-label">Forever</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number">24/7</span>
                        <span class="stat-label">Access</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-flex justify-content-end">
                <div class="position-relative" style="width:240px;height:300px;">
                    <div class="novel-card" style="position:absolute;top:0;right:0;width:160px;rotate:-6deg;opacity:0.85;">
                        <div class="novel-cover-wrap">
                            <img src="/images/2.6 Teaser 2.jpg" alt="Featured Novel" class="novel-cover" loading="lazy" />
                        </div>
                    </div>
                    <div class="novel-card" style="position:absolute;bottom:0;left:0;width:160px;rotate:4deg;opacity:0.75;">
                        <div class="novel-cover-wrap">
                            <img src="/images/Iuno Sky 2.jpg" alt="Featured Novel" class="novel-cover" loading="lazy" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ── Quick Search Bar (HTMX) ───────────────────────────────── -->
<section class="py-3" style="background:var(--bg-surface);border-bottom:1px solid var(--border-color);">
    <div class="container">
        <div class="search-bar-wrap">
            <div class="flex-grow-1 position-relative">
                <input type="text"
                       id="home-search-input"
                       class="search-input-lg"
                       placeholder="Quick search novels..."
                       hx-get="/Novel/Search"
                       hx-trigger="keyup changed delay:400ms, search"
                       hx-target="#home-search-results"
                       hx-push-url="false"
                       name="q"
                       autocomplete="off"
                       aria-label="Quick search novels" />
                <span class="htmx-indicator position-absolute" style="right:0.75rem;top:50%;transform:translateY(-50%);">
                    <div class="spinner"></div>
                </span>
            </div>
        </div>
        <!-- HTMX result drop-in; hidden until user types -->
        <div id="home-search-results" class="mt-2"></div>
    </div>
</section>

<!-- ── Featured Novels ────────────────────────────────────────── -->
@if (featured.Any())
{
    <section class="py-5">
        <div class="container">
            <h2 class="section-title"><i class="bi bi-star-fill text-gold me-1"></i> Top Novels</h2>
            <p class="section-subtitle">Most viewed novels on Tsuki</p>
            <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3">
                @foreach (var novel in featured)
                {
                    <div class="col">
                        <partial name="~/Views/Shared/_NovelCard.cshtml" model="novel" />
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- ── Recently Updated ───────────────────────────────────────── -->
@if (recent.Any())
{
    <section class="py-4 pb-5" style="background:var(--bg-surface);border-top:1px solid var(--border-color);">
        <div class="container">
            <h2 class="section-title mt-2"><i class="bi bi-clock-history me-1 text-gold"></i> Recently Updated</h2>
            <p class="section-subtitle">Latest chapter releases</p>
            <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-4 g-3">
                @foreach (var novel in recent)
                {
                    <div class="col">
                        <partial name="~/Views/Shared/_NovelCard.cshtml" model="novel" />
                    </div>
                }
            </div>
            <div class="text-center mt-4">
                <a asp-controller="Novel" asp-action="Index" class="tsuki-btn-outline" id="btn-view-all">
                    <i class="bi bi-grid-3x3-gap me-1"></i> View All Novels
                </a>
            </div>
        </div>
    </section>
}

<!-- ── Empty state ───────────────────────────────────────────── -->
@if (!featured.Any() && !recent.Any())
{
    <div class="container py-5 text-center">
        <div style="font-size:4rem;">&#128218;</div>
        <h3 class="mt-3" style="color:var(--text-secondary)">No novels yet</h3>
        <p style="color:var(--text-muted)">The library is empty. Log in as Admin to add novels.</p>
        <a asp-controller="Novel" asp-action="Index" class="tsuki-btn-primary mt-2">Browse Library</a>
    </div>
}

<!-- ── Moonlight Quotes ───────────────────────────────────────── -->
<script>
(function () {
    const QUOTES = [
        { text: "The moon does not fight. It attacks no one. It does not worry. It does not try to crush others. It keeps to its course, but by its very nature, it gently influences.", author: "Deng Ming-Dao" },
        { text: "Don't tell me the moon is shining; show me the glint of light on broken glass.", author: "Anton Chekhov" },
        { text: "The moon is a loyal companion. It never leaves. It's always there, watching, full and shining, and we don't have to worry because we know it will always be there.", author: "Tahereh Mafi" },
        { text: "We are all like the bright moon, we still have our darker side.", author: "Khalil Gibran" },
        { text: "Moonlight is sculpture; sunlight is painting.", author: "Nathaniel Hawthorne" },
        { text: "Always remember we are under the same sky, looking at the same moon.", author: "Maxine Lee" },
        { text: "The moon is the reflection of your heart and moonlight is the twinkle of your love.", author: "Debasish Mridha" },
        { text: "Three things cannot be long hidden: the sun, the moon, and the truth.", author: "Gautama Buddha" },
        { text: "Moonlight drowns out all but the brightest stars.", author: "J.R.R. Tolkien" },
        { text: "The moon puts on an elegant show, different every time in shape, colour, and nuance.", author: "Arthur Smith" },
        { text: "Be both soft and wild. Just like the moon. Or the storm. Or the sea.", author: "Victoria Erickson" },
        { text: "The moon is a friend for the lonesome to talk to.", author: "Carl Sandburg" },
        { text: "Shoot for the moon. Even if you miss, you'll land among the stars.", author: "Norman Vincent Peale" },
        { text: "The moon teaches us that even darkness can be beautiful when you find your light within it.", author: "Unknown" },
        { text: "I like to think that the moon is there even if I am not looking at it.", author: "Albert Einstein" },
        { text: "The moon will guide you through the night with her pearly light. She will leave a path for you to follow.", author: "Anthony T. Hincks" },
        { text: "Even the darkest night will end and the sun will rise. But it is the moon that keeps us company through the darkness.", author: "Victor Hugo" },
        { text: "The moon is always full. It is only our view of it that changes.", author: "Matshona Dhliwayo" },
        { text: "When the moon is not full, the stars shine more brightly.", author: "Buganda Proverb" },
        { text: "To the moon and back — that is how far great stories carry us.", author: "Tsuki" }
    ];

    const quoteEl  = document.getElementById('hero-quote');
    const textEl   = document.getElementById('hero-quote-text');
    const authorEl = document.getElementById('hero-quote-author');

    if (!quoteEl || !textEl || !authorEl) return;

    let currentIndex = Math.floor(Math.random() * QUOTES.length);

    function showQuote(index, animate) {
        const q = QUOTES[index];
        if (animate) {
            quoteEl.classList.remove('visible');
            quoteEl.classList.add('fading');
            setTimeout(function () {
                textEl.textContent   = '\u201C' + q.text + '\u201D';
                authorEl.textContent = '\u2014 ' + q.author;
                quoteEl.classList.remove('fading');
                quoteEl.classList.add('visible');
            }, 420);
        } else {
            textEl.textContent   = '\u201C' + q.text + '\u201D';
            authorEl.textContent = '\u2014 ' + q.author;
            setTimeout(function () { quoteEl.classList.add('visible'); }, 700);
        }
    }

    showQuote(currentIndex, false);

    setInterval(function () {
        currentIndex = (currentIndex + 1) % QUOTES.length;
        showQuote(currentIndex, true);
    }, 12000);
})();
</script>


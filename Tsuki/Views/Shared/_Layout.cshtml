@inject UserManager<ApplicationUser> UserManager
@{
    ApplicationUser? currentUser = null;
    if (User.Identity?.IsAuthenticated == true)
    {
        currentUser = await UserManager.GetUserAsync(User);
    }
    var displayName = currentUser?.DisplayName ?? User.Identity?.Name;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Tsuki — Read your favorite light novels and web novels online. Free novel reading platform." />
    <title>@ViewData["Title"] — Tsuki</title>
    <link rel="icon" type="image/x-icon" href="~/favico.ico" />

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;500;600;700;800&family=Merriweather:ital,wght@0,300;0,400;0,700;1,300;1,400&display=swap" rel="stylesheet">
    <!-- Custom site styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- HTMX -->
    <script src="https://unpkg.com/htmx.org@2.0.4" defer></script>
</head>
<body>
    <!-- Gentle Theme Blur Load Overlay -->
    <div class="theme-blur-overlay"></div>

    <!-- ── Navbar ───────────────────────────────────────────────── -->
    <nav class="tsuki-navbar navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand tsuki-brand" asp-controller="Home" asp-action="Index">
                <svg class="brand-logo-svg" viewBox="0 0 122.88 122.89" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="moonGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#38bdf8" />
                            <stop offset="100%" stop-color="#bae6fd" />
                        </linearGradient>
                    </defs>
                    <path fill="url(#moonGradient)" d="M49.06,1.27c2.17-0.45,4.34-0.77,6.48-0.98c2.2-0.21,4.38-0.31,6.53-0.29c1.21,0.01,2.18,1,2.17,2.21 c-0.01,0.93-0.6,1.72-1.42,2.03c-9.15,3.6-16.47,10.31-20.96,18.62c-4.42,8.17-6.1,17.88-4.09,27.68l0.01,0.07 c2.29,11.06,8.83,20.15,17.58,25.91c8.74,5.76,19.67,8.18,30.73,5.92l0.07-0.01c7.96-1.65,14.89-5.49,20.3-10.78 c5.6-5.47,9.56-12.48,11.33-20.16c0.27-1.18,1.45-1.91,2.62-1.64c0.89,0.21,1.53,0.93,1.67,1.78c2.64,16.2-1.35,32.07-10.06,44.71 c-8.67,12.58-22.03,21.97-38.18,25.29c-16.62,3.42-33.05-0.22-46.18-8.86C14.52,104.1,4.69,90.45,1.27,73.83 C-2.07,57.6,1.32,41.55,9.53,28.58C17.78,15.57,30.88,5.64,46.91,1.75c0.31-0.08,0.67-0.16,1.06-0.25l0.01,0l0,0L49.06,1.27 L49.06,1.27z"/>
                </svg>
                <span class="brand-text">Tsuki</span>
            </a>
            <button class="navbar-toggler tsuki-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#navMain"
                    aria-controls="navMain" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list"></i>
            </button>
            <div class="collapse navbar-collapse" id="navMain">
                <ul class="navbar-nav me-auto gap-1">
                    <li class="nav-item">
                        <a class="nav-link tsuki-nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door me-1"></i>Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link tsuki-nav-link" asp-controller="Novel" asp-action="Index">
                            <i class="bi bi-book me-1"></i>Novels
                        </a>
                    </li>
                </ul>

                <!-- Search bar -->
                <form class="d-flex me-3 tsuki-search-form position-relative" action="/Novel" method="get" id="navbar-search-form">
                    <div class="input-group">
                        <input type="text" name="q" id="navbar-search-input" class="form-control tsuki-search-input" placeholder="Search novels..." autocomplete="off"
                               hx-get="/Novel/NavbarSearch"
                               hx-trigger="keyup changed delay:300ms, search"
                               hx-target="#navbar-search-dropdown-results"
                               hx-push-url="false" />
                        <button class="btn tsuki-search-btn" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                    <div id="navbar-search-dropdown-results" class="navbar-search-dropdown-wrapper"></div>
                </form>

                <!-- Auth links -->
                <ul class="navbar-nav gap-1">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link tsuki-nav-link tsuki-admin-badge" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-shield-lock me-1"></i>Admin
                                </a>
                            </li>
                        }
                        <li class="nav-item dropdown">
                            <a class="nav-link tsuki-nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i>@displayName
                            </a>
                            <ul class="dropdown-menu tsuki-dropdown">
                                <li>
                                    <a class="dropdown-item tsuki-dropdown-item" asp-controller="Library" asp-action="Index">
                                        <i class="bi bi-collection-play me-2"></i>My Library
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" style="border-color: var(--border-color);" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item tsuki-dropdown-item">
                                            <i class="bi bi-box-arrow-right me-2"></i>Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link tsuki-nav-link" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn tsuki-btn-primary btn-sm" asp-controller="Account" asp-action="Register">
                                Register
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- ── Main content ─────────────────────────────────────────── -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- ── Footer ───────────────────────────────────────────────── -->
    <footer class="tsuki-footer">
        <div class="container">
            <div class="row align-items-center py-4">
                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <svg class="brand-logo-svg" style="width: 1.25rem; height: 1.25rem;" viewBox="0 0 122.88 122.89" xmlns="http://www.w3.org/2000/svg">
                            <path fill="url(#moonGradient)" d="M49.06,1.27c2.17-0.45,4.34-0.77,6.48-0.98c2.2-0.21,4.38-0.31,6.53-0.29c1.21,0.01,2.18,1,2.17,2.21 c-0.01,0.93-0.6,1.72-1.42,2.03c-9.15,3.6-16.47,10.31-20.96,18.62c-4.42,8.17-6.1,17.88-4.09,27.68l0.01,0.07 c2.29,11.06,8.83,20.15,17.58,25.91c8.74,5.76,19.67,8.18,30.73,5.92l0.07-0.01c7.96-1.65,14.89-5.49,20.3-10.78 c5.6-5.47,9.56-12.48,11.33-20.16c0.27-1.18,1.45-1.91,2.62-1.64c0.89,0.21,1.53,0.93,1.67,1.78c2.64,16.2-1.35,32.07-10.06,44.71 c-8.67,12.58-22.03,21.97-38.18,25.29c-16.62,3.42-33.05-0.22-46.18-8.86C14.52,104.1,4.69,90.45,1.27,73.83 C-2.07,57.6,1.32,41.55,9.53,28.58C17.78,15.57,30.88,5.64,46.91,1.75c0.31-0.08,0.67-0.16,1.06-0.25l0.01,0l0,0L49.06,1.27 L49.06,1.27z"/>
                        </svg>
                        <span class="footer-brand" style="margin-left:0; font-size: 1.25rem;">Tsuki</span>
                    </div>
                    <p class="footer-tagline mt-1">Your portal to endless stories.</p>
                </div>
                <div class="col-md-4 text-center">
                    <a asp-controller="Novel" asp-action="Index" class="footer-link me-3">Novels</a>
                    <a asp-controller="Home" asp-action="Index" class="footer-link">Home</a>
                </div>
                <div class="col-md-4 text-end">
                    <span class="footer-copy">&copy; 2026 Tsuki — University Project</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://unpkg.com/htmx.org@2.0.4/dist/htmx.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Inject antiforgery token into every HTMX request automatically
        document.addEventListener('htmx:configRequest', function (evt) {
            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) {
                evt.detail.headers['RequestVerificationToken'] = token.value;
            }
        });

        // Scroll to top on every HTMX content swap (chapter navigation)
        document.body.addEventListener('htmx:afterSwap', function (evt) {
            if (evt.detail.target && evt.detail.target.id === 'reader-wrap') {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        });

        // Hide navbar search dropdown when clicking outside
        document.addEventListener('click', function (e) {
            const form = document.getElementById('navbar-search-form');
            const dropdown = document.getElementById('navbar-search-dropdown-results');
            if (form && dropdown && !form.contains(e.target)) {
                dropdown.innerHTML = '';
            }
        });
    </script>
    @Html.AntiForgeryToken()
    @RenderSection("Scripts", required: false)
</body>
</html>
